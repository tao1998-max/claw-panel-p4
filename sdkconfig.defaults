# ===== 目标芯片 =====
CONFIG_IDF_TARGET="esp32p4"
# 本板 P4 为 rev < 3.0（与厂商所有示例一致，必须设置）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ===== Flash / 分区 =====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 本板为 Boya 16MB flash；启用专用驱动，避免启动日志的 generic driver 警告
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ===== PSRAM（叠封 32MB，HEX 模式 200MHz）=====
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# 官方 P4 方案：.text/.rodata 启动时搬到 PSRAM 执行。这样 SPI1 flash 写
# 走 SPI_FLASH_CACHE_NO_DISABLE 路径，不再关 cache，DPI 不会欠载闪屏。
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ===== BSP 板级配置 =====
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_I2S_NUM=1
CONFIG_BSP_LCD_TYPE_1024_600=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_USE_DMA2D=y
# 官方防撕裂方案：双 DPI framebuffer + LVGL direct mode。
# LVGL 只把脏区绘制到当前 DPI framebuffer，再同步脏区到另一块缓冲，
# 在 VSYNC 回调里切换扫描缓冲；相比 full refresh 不会每次重绘整屏。
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
# CONFIG_BSP_DISPLAY_LVGL_FULL_REFRESH is not set
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
CONFIG_BSP_DISPLAY_BRIGHTNESS_LEDC_CH=1
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"

# ===== LVGL 9 =====
CONFIG_LV_COLOR_DEPTH_16=y
# 文字用自生成的 font_zh_*（见 tools/fonts），图标仍用内置 Montserrat 的符号
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 内置字体按名引用（font = "montserrat_32"），供 Lua App 放大标题/时钟
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 桌面框架会反复创建/销毁页面对象；用自定义分配器把 LVGL 对象放到 PSRAM，
# 把内部 RAM 留给 Wi-Fi/音频/Agent/Lua 栈。
CONFIG_LV_USE_CUSTOM_MALLOC=y
# App 内 TTF 字体（21 点游戏的牌面/标题）
CONFIG_LV_USE_TINY_TTF=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_FREERTOS_TASK_NOTIFY=y
# 双指缩放：手势识别依赖浮点；GT911 已配置为 5 点触摸
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
# Lua 通用属性通道 obj:set_property/get_property（按名字查属性 ID 需要 *_NAME）
CONFIG_LV_USE_OBJ_PROPERTY=y
CONFIG_LV_USE_OBJ_PROPERTY_NAME=y
# Lottie（lv_lottie）基于内置 ThorVG 软件渲染
CONFIG_LV_USE_VECTOR_GRAPHIC=y
CONFIG_LV_USE_THORVG=y
CONFIG_LV_USE_THORVG_INTERNAL=y
CONFIG_LV_USE_LOTTIE=y
# LVGL 图片源解码：PNG/JPEG/GIF（animimg / image / imagebutton / gif 的 src 路径）
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_GIF_CACHE_DECODE_DATA=y
# 解码后的图片缓存（PSRAM）：避免逐帧重复解码
CONFIG_LV_CACHE_DEF_SIZE=8388608
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=64

# ===== 可选外设（模板默认开启并做上电自检）=====
# CONFIG_TEMPLATE_ENABLE_CAMERA is not set
CONFIG_TEMPLATE_ENABLE_WIFI=y
CONFIG_TEMPLATE_WIFI_SSID=""
CONFIG_TEMPLATE_WIFI_PASSWORD=""

# 摄像头：本板模组是 OV02C10（I2C 0x36，Chip ID 0x5602），与官方 video_lcd_display 一致。
# 只开这一个 sensor，其他型号关掉可以省 flash 和探测时间。
# 注意 1-lane 1080p RAW10 必须开 ISP，否则 /dev/video0 出不了图。
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920X1080_30FPS_1_LANE=y
CONFIG_CAMERA_OV02C10_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS_1_LANE=y
CONFIG_CAMERA_OV02C10_MIPI_IF_FORMAT_INDEX_DEFAULT=1
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# ===== 小智 AI（可剪裁）=====
CONFIG_TEMPLATE_ENABLE_XIAOZHI=y
# cbin 聊天字体要求 LVGL 打开大字体描述符，与参考固件一致
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# esp-sr：只用“你好小智”WakeNet，关闭中英文命令词模型，启用 WebRTC NS/VAD
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y

# 官方 McpServer 的属性校验使用 try/catch
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024

# ===== FATFS（AI 资源 + ESP-Claw 工作区，统一挂载到 /fatfs）=====
# 内部 4 MB FAT + SD 卡，留两个余量
CONFIG_FATFS_VOLUME_COUNT=4
# 摄像头/控制台/内部 FAT/SD 都要注册 VFS 路径，默认 8 个不够用
CONFIG_VFS_MAX_COUNT=16
# 脚本/技能文件名超过 8.3，必须开长文件名；用堆分配（PSRAM 优先）避免占任务栈。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# 允许中文文件名（AI/用户脚本命名）
CONFIG_FATFS_CODEPAGE_936=y

# ===== 系统 =====
# ESP32-P4 + ESP32-C6 hosted Wi-Fi；新生成的 sdkconfig 必须显式选中从机目标，
# 否则 esp_hosted 的 Kconfig 会落到 "invalid" 并编译失败。
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
# 本板 C6 走 SDIO（不是 SPI）；丢失这些选项会导致 C6 链路起不来。
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
# CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE is not set
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Wi-Fi 事件回调在 sys_evt 任务里跑，扫描结果解析 + 日志需要更大栈
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ESP-Claw Web UI: /ws/webim uses HTTPD WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# ESP-Claw Web UI + XiaoZhi WSS share the LWIP socket pool. 28 = HTTPD's
# 10 clients + 3 internal + XiaoZhi WSS + Lua net/mqtt/websocket caps + slack.
CONFIG_LWIP_MAX_SOCKETS=28

# Lua 的大块对象（脚本/字符串/栈）放 PSRAM，避免占用内部 DMA 内存；
# 内部内存还要留给 TLS/AES、ESP-Hosted SDIO 和音频。
CONFIG_LUA_USE_PSRAM=y

# TLS verification bundle for HTTPS / mqtts / wss clients
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Lua `insecure` option: allow esp-tls clients without a configured CA
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# 豆包/第三方 WSS 的 401/101 响应头可能超过 1 KB
CONFIG_WS_BUFFER_SIZE=4096
